from fastapi import APIRouter, HTTPException, Request
from pydantic import BaseModel

router = APIRouter()

# ─────────────────────────────────────────────
# 📦 Request Models
# ─────────────────────────────────────────────
class QueryRequest(BaseModel):
    q: str
    top_k: int = 5
    profile: dict | None = None


class MealPlanRequest(BaseModel):
    profile: dict


class ExplainMealRequest(BaseModel):
    meal_name: str
    context: str | None = None


# ─────────────────────────────────────────────
# 🧠 SERVICES (بدل ملفات خارجية)
# ─────────────────────────────────────────────

def rag_answer_hybrid_service(query: str, top_k: int = 5):
    """
    RAG logic (mock حالياً)
    لاحقًا تربطه بـ embeddings + vector DB
    """
    answer = f"RAG answer for: {query}"
    context = ["doc1", "doc2", "doc3"]
    return answer, context


def generate_meal_plan(profile: dict):
    """
    Meal plan generator (simple logic)
    """
    goal = profile.get("goal", "Maintain")

    if goal == "Lose Weight":
        plan = "Low calorie Mediterranean plan"
    elif goal == "Gain Muscle":
        plan = "High protein plan"
    else:
        plan = "Balanced diet plan"

    return {
        "goal": goal,
        "plan": plan,
        "sample_day": {
            "breakfast": "Oats + yogurt",
            "lunch": "Chicken salad",
            "dinner": "Fish + vegetables"
        }
    }


def explain_meal(meal_name: str, context: str | None = None):
    """
    Explain meal logic
    """
    return f"{meal_name} is a balanced meal rich in protein and nutrients."


# ─────────────────────────────────────────────
# 🧠 1. RAG (CHAT ONLY)
# ─────────────────────────────────────────────
@router.post("/query")
def query_rag(request: Request, body: QueryRequest):
    try:
        if not getattr(request.app.state, "ready", True):
            raise HTTPException(status_code=503, detail="System not ready")

        answer, context = rag_answer_hybrid_service(
            body.q,
            top_k=body.top_k
        )

        return {
            "answer": answer,
            "context": context,
            "query": body.q
        }

    except Exception:
        raise HTTPException(
            status_code=500,
            detail="Error in /query"
        )


# ─────────────────────────────────────────────
# 🍽️ 2. Generate Meal Plan
# ─────────────────────────────────────────────
@router.post("/generate-plan")
def generate_plan_api(request: Request, body: MealPlanRequest):
    try:
        if not getattr(request.app.state, "ready", True):
            raise HTTPException(status_code=503, detail="System not ready")

        plan = generate_meal_plan(body.profile)

        return {
            "plan": plan
        }

    except Exception:
        raise HTTPException(
            status_code=500,
            detail="Error in /generate-plan"
        )


# ─────────────────────────────────────────────
# 🥗 3. Explain Meal
# ─────────────────────────────────────────────
@router.post("/explain-meal")
def explain_meal_api(request: Request, body: ExplainMealRequest):
    try:
        if not getattr(request.app.state, "ready", True):
            raise HTTPException(status_code=503, detail="System not ready")

        explanation = explain_meal(body.meal_name, body.context)

        return {
            "meal": body.meal_name,
            "explanation": explanation
        }

    except Exception:
        raise HTTPException(
            status_code=500,
            detail="Error in /explain-meal"
        )


# ─────────────────────────────────────────────
# 📊 Status
# ─────────────────────────────────────────────
@router.get("/status")
def status(request: Request):
    return {
        "status": "ready" if getattr(request.app.state, "ready", False) else "starting"
    }


# ─────────────────────────────────────────────
# 🏠 Root
# ─────────────────────────────────────────────
@router.get("/")
def root():
    return {
        "message": "All-in-one Nutrition API running",
        "endpoints": [
            "POST /query",
            "POST /generate-plan",
            "POST /explain-meal",
            "GET /status"
        ]
    }
